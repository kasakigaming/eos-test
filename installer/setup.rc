#include <windows.h>

// The proxy DLL built by build.bat, embedded so the installer is a single exe.
// Found through the include paths passed to rc.exe.
PROXYDLL RCDATA "EOSSDK-Win64-Shipping.dll"

1 RT_MANIFEST "setup.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "EOS Proxy Setup"
            VALUE "FileVersion",     "1.0.0.0"
            VALUE "InternalName",    "eos-proxy-setup"
            VALUE "OriginalFilename","eos-proxy-setup.exe"
            VALUE "ProductName",     "EOS Proxy"
            VALUE "ProductVersion",  "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
