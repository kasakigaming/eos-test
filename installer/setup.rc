#include <windows.h>

// The proxy DLL built by build.bat, embedded so the installer is a single exe.
// Found through the include paths passed to rc.exe.
PROXYDLL RCDATA "EOSSDK-Win64-Shipping.dll"

// The Steam auth backends, packed from installer\payload\<name> by
// tools\pack.c. build.bat always produces these two, empty when nobody has
// dropped the third party binaries in yet, and the installer then reports that
// backend as not bundled. SLSsteam is Linux only so only its config is here.
// Stand-in for an Easy Anti-Cheat bootstrapper, dropped over a game's own
// launcher so the game starts without the anti-cheat that refuses to load the
// proxy. Built by build.bat from installer\launcher.c.
LAUNCHER RCDATA "eos-proxy-launcher.exe"

GBEFORK  RCDATA "gbe_fork.pak"
UCONLINE RCDATA "uc-online2.pak"
SLSCONF  RCDATA "slssteam-config.yaml"

1 RT_MANIFEST "setup.manifest"

// t19 - the first build of the setup that gets The Isle (evrima) online:
// backend beside the game's own steam_api64.dll, gbe_fork under it, and the
// anti-cheat bootstrapper replaced so the proxy is allowed to load at all.
// t29 - the proxy also answers the game's official network status request, so
// the main menu stops reporting the network as offline. See src\warp.h.
// t39 - the whole matchmaker is relayed, not just the status call: the server
// browser fills, and a refused /v1/match/request is answered locally with the
// server id as the session id so joining has a path to try.
// t49 - EOS_AntiCheatClient_BeginSession is answered as success, so the net
// driver stops refusing to bring the connection up on a machine where the
// anti-cheat client cannot run. Nothing is defeated outside this process.
// t59 - the session id guess held: the client finds the session warp.h names.
// What stops a join is now somewhere between finding it and connecting, so the
// rest of that path is hooked and logged. Watching only, nothing changed.
// t69 - a t59 run joined the session and then failed to build a net driver at
// all, before any anti-cheat call. GetAntiCheatClientInterface is hooked to say
// whether the driver is even handed the interface it needs.
// t79 - that hook answered it: the SDK hands back no anti-cheat client at all
// on a machine where EAC cannot run, so the driver gave up before building.
// The proxy now stands in for the interface itself and answers every call made
// against it. Servers running the server half still refuse this.
// SETUP_VERSION in setup.c prints the same thing at runtime.
VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,10,0,0
PRODUCTVERSION  1,10,0,0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "EOS Proxy Setup"
            VALUE "FileVersion",     "1.10.0.0"
            VALUE "InternalName",    "eos-proxy-setup"
            VALUE "OriginalFilename","eos-proxy-setup.exe"
            VALUE "ProductName",     "EOS Proxy"
            VALUE "ProductVersion",  "t89 (test 8, 2026-09-10)"
            VALUE "Comments",        "The Isle evrima: proxy + gbe_fork + anti-cheat launcher stand-in"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
